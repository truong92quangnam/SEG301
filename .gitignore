# Python virtual environments & bytecode
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Large datasets & raw archives
cifar-10/
cifar10/
data/
*.parquet
*.tar.gz
*.csv.gz

# Checkpoints & heavy model weights (avoid storing ~230MB binary weights in git)
*.pth
*.pt
*.npz

# Outputs: allow tracking experiment logs, metadata, and per-query metrics for auditability
outputs/experiments/**/checkpoint*.pth
outputs/experiments/**/*.npz
!outputs/experiments/**/training_logs.csv
!outputs/experiments/**/run_metadata.json
!outputs/experiments/**/per_query_metrics.csv
*.log
cifar-10-batches-py

